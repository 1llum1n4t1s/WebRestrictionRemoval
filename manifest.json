{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "version": "1.1.11",
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "__MSG_defaultTitle__",
    "default_popup": "src/popup/popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "exclude_matches": [
        "*://*.youtube.com/live_chat*"
      ],
      "js": [
        "src/lib/actions.js",
        "src/lib/cleaner-core.js",
        "src/content/youtube-player-overlay.js",
        "src/content/youtube-player-controls.js"
      ],
      "css": [
        "src/content/youtube-player-controls.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "exclude_matches": ["*://*.youtube.com/live_chat*"],
      "js": ["src/content/youtube-player-controls-main.js"],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/early-framework.js", "src/content/youtube-early.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/lib/actions.js", "src/lib/cleaner-core.js", "src/content/youtube-player-overlay.js", "src/content/youtube-shorts.js", "src/content/search-fixer.js", "src/content/youtube-broadcast-clock.js", "src/content/youtube-notebooklm.js"],
      "css": ["src/content/youtube-shorts.css", "src/content/search-fixer.css", "src/content/youtube-broadcast-clock.css", "src/content/youtube-notebooklm.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://www.amazon.co.jp/auto-deliveries*"],
      "js": ["src/lib/actions.js", "src/lib/scan-runner.js", "src/lib/cleaner-core.js", "src/content/amazon-delivery-total.js"],
      "css": ["src/content/amazon-delivery-total.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://www.amazon.co.jp/*"],
      "js": ["src/lib/actions.js", "src/lib/scan-runner.js", "src/lib/cleaner-core.js", "src/content/amazon-ranking-jump.js"],
      "css": ["src/content/amazon-ranking-jump.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://www.amazon.co.jp/*"],
      "js": ["src/lib/actions.js", "src/lib/scan-runner.js", "src/lib/cleaner-core.js", "src/content/amazon-merchant-info.js"],
      "css": ["src/content/amazon-merchant-info.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["src/content/early-framework.js", "src/content/instagram-early.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["src/lib/actions.js", "src/lib/cleaner-core.js", "src/content/instagram-cleaner.js", "src/content/instagram-video-controls.js", "src/content/image-downloader.js"],
      "css": ["src/content/instagram-cleaner.css", "src/content/instagram-video-controls.css", "src/content/image-downloader.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["src/content/early-framework.js", "src/content/tiktok-early.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["src/lib/actions.js", "src/lib/cleaner-core.js", "src/content/tiktok-cleaner.js", "src/content/image-downloader.js"],
      "css": ["src/content/tiktok-cleaner.css", "src/content/image-downloader.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://x.com/*", "*://*.x.com/*", "*://twitter.com/*", "*://*.twitter.com/*"],
      "js": ["src/content/early-framework.js", "src/content/x-early.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://x.com/*", "*://*.x.com/*", "*://twitter.com/*", "*://*.twitter.com/*"],
      "js": ["src/lib/actions.js", "src/lib/cleaner-core.js", "src/content/x-cleaner.js"],
      "css": ["src/content/x-cleaner.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/lib/actions.js", "src/content/video-gamma.js", "src/content/video-fill.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/lib/actions.js", "src/content/loupe.js"],
      "css": ["src/content/loupe.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "offscreen",
    "tabCapture"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; frame-ancestors 'none'"
  },
  "minimum_chrome_version": "140",
  "commands": {
    "youtube-quality-1": {
      "description": "__MSG_ypcCommand_quality_1__"
    },
    "youtube-quality-2": {
      "description": "__MSG_ypcCommand_quality_2__"
    },
    "youtube-quality-3": {
      "description": "__MSG_ypcCommand_quality_3__"
    },
    "youtube-quality-4": {
      "description": "__MSG_ypcCommand_quality_4__"
    },
    "youtube-quality-5": {
      "description": "__MSG_ypcCommand_quality_5__"
    },
    "youtube-quality-6": {
      "description": "__MSG_ypcCommand_quality_6__"
    },
    "youtube-quality-7": {
      "description": "__MSG_ypcCommand_quality_7__"
    },
    "youtube-quality-8": {
      "description": "__MSG_ypcCommand_quality_8__"
    },
    "youtube-quality-9": {
      "description": "__MSG_ypcCommand_quality_9__"
    },
    "youtube-rate-1": {
      "description": "__MSG_ypcCommand_rate_1__"
    },
    "youtube-rate-2": {
      "description": "__MSG_ypcCommand_rate_2__"
    },
    "youtube-rate-3": {
      "description": "__MSG_ypcCommand_rate_3__"
    },
    "youtube-rate-4": {
      "description": "__MSG_ypcCommand_rate_4__"
    },
    "youtube-rate-5": {
      "description": "__MSG_ypcCommand_rate_5__"
    },
    "youtube-rate-6": {
      "description": "__MSG_ypcCommand_rate_6__"
    },
    "youtube-rate-7": {
      "description": "__MSG_ypcCommand_rate_7__"
    },
    "youtube-rate-8": {
      "description": "__MSG_ypcCommand_rate_8__"
    },
    "youtube-volume-1": {
      "description": "__MSG_ypcCommand_volume_1__"
    },
    "youtube-volume-2": {
      "description": "__MSG_ypcCommand_volume_2__"
    },
    "youtube-volume-3": {
      "description": "__MSG_ypcCommand_volume_3__"
    },
    "youtube-volume-4": {
      "description": "__MSG_ypcCommand_volume_4__"
    },
    "youtube-volume-5": {
      "description": "__MSG_ypcCommand_volume_5__"
    }
  }
}
