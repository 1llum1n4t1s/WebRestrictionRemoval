{
  "name": "web-viewing-assist",
  "version": "1.0.36",
  "type": "commonjs",
  "description": "Chrome extension that bundles session keep-alive, YouTube cleaner, Amazon auto-delivery totals, and a per-tab volume booster.",
  "scripts": {
    "ci:install": "npm ci",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-screenshots": "node webstore/generate-screenshots.js",
    "build": "npm run generate-icons && npm run generate-screenshots",
    "test": "node --test",
    "lint": "eslint src/ test/ scripts/"
  },
  "devDependencies": {
    "chrome-webstore-upload-cli": "^4.0.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "puppeteer": "^25.0.4",
    "sharp": "0.34.5",
    "web-ext": "10.2.0"
  },
  "keywords": [
    "chrome-extension",
    "session-keep-alive",
    "youtube-cleaner",
    "amazon",
    "volume-booster",
    "web-viewing"
  ],
  "author": "",
  "license": "MIT"
}
